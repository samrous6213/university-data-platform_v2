# Copier ce fichier en .env avant le premier "docker compose up" :
#   cp .env.example .env
#
# .env est dans .gitignore (ne JAMAIS committer de vrais secrets), mais
# docker-compose.yml monte ./.env dans le conteneur Airflow -- sans ce
# fichier present (meme avec des valeurs par defaut sans danger, comme
# ci-dessous), Docker refuse de demarrer ou cree un dossier vide nomme
# .env a la place d'un fichier. Toujours garder ce .env.example a jour
# avec toutes les variables utilisees par src/ (grep "os.getenv" pour
# verifier qu'aucune n'a ete oubliee ici).

# ── MinIO ──
# Valeur ci-dessous pour reference/debug local hors Docker uniquement.
# Dans les conteneurs (Airflow, Spark), docker-compose.yml surcharge
# TOUJOURS cette valeur avec MINIO_ENDPOINT=minio:9000 (nom de service
# Docker) -- voir x-airflow-common dans docker-compose.yml.
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_RAW_JSON_BUCKET=raw-json

# ── OpenAlex ──
OPENALEX_BASE_URL=https://api.openalex.org
OPENALEX_MAILTO=data-team@example.ma
OPENALEX_PER_PAGE=100
OPENALEX_MAX_RETRIES=5

# ── Hive Metastore / Postgres analytics / Elasticsearch / Hudi ──
# Valeurs ci-dessous pour reference/debug local hors Docker uniquement
# (memes defaults que configs/spark_config.py). Dans les conteneurs
# Airflow, docker-compose.yml surcharge TOUJOURS HIVE_METASTORE_URI,
# POSTGRES_ANALYTICS_HOST et ELASTICSEARCH_HOST avec les noms de service
# Docker (hive-metastore, postgres, elasticsearch) -- voir
# x-airflow-common dans docker-compose.yml.
HIVE_METASTORE_URI=thrift://localhost:9083
HUDI_WAREHOUSE_PATH=s3a://curated/hudi
POSTGRES_ANALYTICS_HOST=127.0.0.1
POSTGRES_ANALYTICS_PORT=5432
POSTGRES_ANALYTICS_DB=analytics
POSTGRES_ANALYTICS_USER=hive
POSTGRES_ANALYTICS_PASSWORD=hive
ELASTICSEARCH_HOST=127.0.0.1
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_INDEX=university_search

# ── Divers ──
SPARK_LOG_DIR=logs
MAX_WRITE_RETRIES=3
RETRY_BACKOFF_FACTOR=2
